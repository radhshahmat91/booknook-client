# --- Express API (booknook-server) ---
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- imgbb image uploads: https://api.imgbb.com/ ---
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# --- BetterAuth ---
BETTER_AUTH_URL=http://localhost:3000
# On Vercel, set this to your exact deployed frontend URL (https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-one-with-openssl-rand-base64-32

# --- MongoDB (same database the server uses) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=booknook

# --- Google login (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT shared with the server: must match JWT_SECRET in booknook-server ---
JWT_SECRET=replace-with-a-long-random-string
